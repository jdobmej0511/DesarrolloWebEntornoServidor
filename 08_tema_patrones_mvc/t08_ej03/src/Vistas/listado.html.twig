{% extends "base.html.twig" %}

{% block titulo %}Rutas disponibles{% endblock %}

{% block contenido %}
    <h1 class="mb-4">Rutas disponibles</h1>

    <form method="get" action="index.php" class="row g-2 align-items-end mb-4">
        <input type="hidden" name="accion" value="listar">
        <div class="col-auto">
            <label for="dificultad" class="form-label">Dificultad</label>
            <select id="dificultad" name="dificultad" class="form-select">
                <option value="">Todas</option>
                {% for dificultad in dificultades %}
                    <option value="{{ dificultad.value }}" {{ dificultad.value == seleccionada ? "selected" }}>{{ dificultad.value|capitalize }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-success">Filtrar</button>
        </div>
    </form>

    {% if error %}
        <div class="alert alert-danger">{{ error }}</div>
    {% endif %}

    {% if rutas is empty %}
        <div class="alert alert-info">No hay rutas con esa dificultad.</div>
    {% else %}
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-success">
                <tr>
                    <th>Nombre</th>
                    <th>Localidad</th>
                    <th>Dificultad</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for ruta in rutas %}
                    <tr>
                        <td>{{ ruta.nombre }}</td>
                        <td>{{ ruta.localidad }}</td>
                        <td>{{ ruta.dificultad.value|capitalize }}</td>
                        <td><a href="index.php?accion=ver&id={{ ruta.idRuta }}" class="btn btn-sm btn-outline-success">Ver ruta</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
