{% extends "base.html.twig" %}

{% block titulo %}Rutas disponibles{% endblock %}

{% block contenido %}
    <h1>Rutas disponibles</h1>

    <form method="get" action="index.php">
        <input type="hidden" name="accion" value="listar">
        <label for="dificultad">Dificultad</label>
        <select id="dificultad" name="dificultad">
            <option value="">Todas</option>
            {% for dificultad in dificultades %}
                <option value="{{ dificultad.value }}" {{ dificultad.value == seleccionada ? "selected" }}>{{ dificultad.value|capitalize }}</option>
            {% endfor %}
        </select>
        <button type="submit">Filtrar</button>
    </form>

    {% if error %}
        <p>{{ error }}</p>
    {% endif %}

    {% if rutas is empty %}
        <p>No hay rutas con esa dificultad.</p>
    {% else %}
        <table border="1">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Localidad</th>
                    <th>Dificultad</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for ruta in rutas %}
                    <tr>
                        <td>{{ ruta.nombre }}</td>
                        <td>{{ ruta.localidad }}</td>
                        <td>{{ ruta.dificultad.value|capitalize }}</td>
                        <td><a href="index.php?accion=ver&id={{ ruta.idRuta }}">Ver ruta</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
