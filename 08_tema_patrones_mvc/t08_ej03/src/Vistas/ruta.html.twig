{% extends "base.html.twig" %}

{% block titulo %}{{ ruta.nombre }}{% endblock %}

{% block contenido %}
    <p>{{ ruta.nombre }}</p>

    <ul>
        <li>Identificador: {{ ruta.idRuta }}</li>
        <li>Localidad: {{ ruta.localidad }}</li>
        <li>Distancia: {{ ruta.distancia|number_format(2, ",", ".") }} km</li>
        <li>Desnivel: {{ ruta.desnivel }} m</li>
        <li>Dificultad: {{ ruta.dificultad.value|capitalize }}</li>
    </ul>

    <p><a href="index.php">Volver al listado</a></p>
{% endblock %}
